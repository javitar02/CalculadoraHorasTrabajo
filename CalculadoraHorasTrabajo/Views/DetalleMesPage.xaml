<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculadoraHorasTrabajo.Views.DetalleMesPage"
             Title="Detalle Mes">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="TituloMes" FontSize="18" FontAttributes="Bold" />
            <Label Text="Horas diarias" FontAttributes="Bold" />
            <CollectionView x:Name="DiariasCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10" BorderColor="LightGray" CornerRadius="8" HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label Grid.Column="1" Text="{Binding HorasNetas, StringFormat='{0:0.00} h'}" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <BoxView HeightRequest="1" Color="LightGray" />
            <Label Text="Resumen semanal" FontAttributes="Bold" />
            <CollectionView x:Name="SemanalesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10" BorderColor="LightGray" CornerRadius="8" HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Rango}" />
                                <Label Grid.Column="1" Text="{Binding TotalHoras, StringFormat='{0:0.00} h'}" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
