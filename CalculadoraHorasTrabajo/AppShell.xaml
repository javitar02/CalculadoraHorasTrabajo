<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalculadoraHorasTrabajo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculadoraHorasTrabajo"
    xmlns:views="clr-namespace:CalculadoraHorasTrabajo.Views"
    Title="CalculadoraHorasTrabajo"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Registro Horas" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Picaje" Route="PicajePage">
        <ShellContent ContentTemplate="{DataTemplate views:PicajePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Resumen Horas" Route="ResumenPage">
        <ShellContent ContentTemplate="{DataTemplate views:ResumenPage}" />
    </FlyoutItem>

</Shell>
