<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalculadoraHorasTrabajo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculadoraHorasTrabajo"
    xmlns:views="clr-namespace:CalculadoraHorasTrabajo.Views"
    Title="CalculadoraHorasTrabajo">

    <TabBar>
        <ShellContent
            Title="Registro Horas"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Resumen Horas"
            ContentTemplate="{DataTemplate views:ResumenPage}"
            Route="ResumenPage" />
    </TabBar>

</Shell>
