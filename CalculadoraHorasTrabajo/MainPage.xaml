<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CalculadoraHorasTrabajo.Models"
             xmlns:vm="clr-namespace:CalculadoraHorasTrabajo.ViewModels"
             x:Class="CalculadoraHorasTrabajo.MainPage"
             Title="Calculadora de Horas"
             x:DataType="vm:MainViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Nuevo registro" FontSize="18" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Fecha" />
                <DatePicker Grid.Row="1" Grid.Column="0" Date="{Binding Fecha}" />

                <Label Grid.Row="0" Grid.Column="1" Text="Descanso (minutos)" />
                <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding DescansoMinutosTexto}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Hora entrada" />
                    <TimePicker Time="{Binding HoraEntrada}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Hora salida" />
                    <TimePicker Time="{Binding HoraSalida}" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="Guardar" Command="{Binding GuardarCommand}" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Registros guardados" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Registros}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RegistroDiario">
                        <Frame Margin="0,4" Padding="12" BorderColor="LightGray" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" FontSize="16" />
                                    <Label Grid.Column="1" Text="{Binding HorasNetas, StringFormat='{0:0.00} h'}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Entrada:" />
                                        <Label Text="{Binding HoraEntrada, StringFormat='{0:hh\\:mm}'}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Salida:" />
                                        <Label Text="{Binding HoraSalida, StringFormat='{0:hh\\:mm}'}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Descanso:" />
                                    <Label Text="{Binding DescansoMinutos, StringFormat='{0} min'}" />
                                </HorizontalStackLayout>
                                <Button Text="Eliminar" HorizontalOptions="End" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
